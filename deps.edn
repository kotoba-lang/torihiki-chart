{:paths ["src"]
 ;; torihiki-chart — 取引所チャートの幾何。ADR-2608040300 (com-junkawasaki/root)。
 ;;
 ;; scale と shape は再発明しない。`kotoba-lang/d3` が d3-scale / d3-shape の
 ;; native cljc 再実装（JS interop ではない）を既に持っており、その `band-scale`
 ;; が返す {:start :end :width} はちょうど candle の body が要る形。
 ;;
 ;; SVG の描画側 (`org-w3-svg`) には依存しない。出力は hiccup の
 ;; [:tag {:attrs} & children] で、それをどう文字列にするかは消費者が決める
 ;; （`kotoba-lang/html` でも `org-w3-svg` でも、ブラウザで直接 DOM にしても
 ;;  よい）。`d3` が `svg` に依存しないのと同じ理由 —— 依存を減らすためではなく、
 ;; 出力が「文字列」ではなく「データ」であることを保つため。
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/d3
        {:git/url "https://github.com/kotoba-lang/d3.git"
         :git/sha "41f55ee8cb33193cde0d58cdd7a97e3ee51e16fa"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}}}
